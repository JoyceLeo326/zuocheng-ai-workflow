{
  "name": "@zuocheng/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsx watch src/index.ts",
    "pretest": "pnpm --filter @zuocheng/contracts build && pnpm --filter @zuocheng/config build",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/passkey": "1.6.25",
    "@hono/node-server": "2.0.11",
    "@zuocheng/config": "workspace:*",
    "@zuocheng/contracts": "workspace:*",
    "better-auth": "1.6.25",
    "hono": "4.12.31",
    "pg": "8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "tsup": "8.5.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
