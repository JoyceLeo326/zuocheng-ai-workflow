# Copy to deploy/.env.production on infrastructure owned by the deploying tenant.
DEPLOYMENT_MODE=tenant-managed-production
COST_MODE=zero_owner_cost
OWNER_BILLING_MODE=deny
ALLOW_OWNER_BILLED_PROVIDER=false
ALLOW_AUTO_TOPUP=false
ALLOW_AUTO_UPGRADE=false
PROVIDER_CREDENTIAL_SOURCE=tenant_only
REMOTE_UNKNOWN_QUOTA=deny
STORAGE_DEFAULT=tenant_byos
REQUIRE_LEDGER_RESERVATION=true
TENANT_CONTEXT_REQUIRED=true

# Images must be supplied by the customer registry and pinned by sha256 digest.
POSTGRES_IMAGE=postgres@sha256:REPLACE_WITH_CUSTOMER_REVIEWED_DIGEST
ZUOCHENG_API_IMAGE=registry.example/zuocheng-api@sha256:REPLACE_WITH_RELEASE_DIGEST
ZUOCHENG_WORKER_IMAGE=registry.example/zuocheng-worker@sha256:REPLACE_WITH_RELEASE_DIGEST

POSTGRES_DB=zuocheng
POSTGRES_USER=zuocheng
POSTGRES_PASSWORD=REPLACE_WITH_CUSTOMER_SECRET
API_BIND_ADDRESS=127.0.0.1
API_PORT=3000

